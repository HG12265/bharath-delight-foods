PORT=8000
HOST=0.0.0.0
NODE_ENV=development
SECRET_KEY=replace-with-your-existing-secret-or-a-random-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=11520
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
COOKIE_SAMESITE=lax
TRUST_PROXY=false
MAX_REQUEST_SIZE_BYTES=16777216
STATIC_DIR=static
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist
# Optional providers. Reuse your existing provider configuration values.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0"
DATABASE_NAME="mr_bharath_foods"

UPI_ID="your-upi-id@oksbi"

# Storage: Cloudinary Persistent Cloud Media Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Brevo Transactional Email Service
BREVO_API_KEY="your-brevo-api-key-here"
BREVO_SENDER_EMAIL="support@bharathdelightfoods.in"
BREVO_SENDER_NAME="Bharath Delight Foods"

# Admin Credentials
ADMIN_EMAIL="admin@bharathdelightfoods.in"
ADMIN_PHONE="9150141007"
ADMIN_PASSWORD="your-secure-password"

# PhonePe Payment Gateway (Standard Checkout V2)
PHONEPE_MERCHANT_ID=""
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_VERSION="1"
PHONEPE_CLIENT_SECRET=""
PHONEPE_ENV="PRODUCTION"
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""
